# ── Database ──
POSTGRES_USER=gohiking
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ── Domain ──
DOMAIN=your-domain.com

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── AI Scoring (choose one) ──
# Options: gemini, claude, openai, ollama
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# CLAUDE_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Storage ──
# Options: local, s3, veimagex
STORAGE_BACKEND=local

# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=gohiking-photos
# S3_PUBLIC_ENDPOINT=https://your-cdn.com

# ── Remote Images (optional, for CI/CD deploy) ──
# 如果使用 ./deploy.sh --remote 从镜像仓库拉取，需配置以下两项
# BACKEND_IMAGE=ghcr.io/yourname/gohiking-backend:latest
# FRONTEND_IMAGE=ghcr.io/yourname/gohiking-frontend:latest
